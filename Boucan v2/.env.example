# ─── BOUCAN — variables d'environnement du serveur ────────────────────────────
# Copier ce fichier en `.env` (jamais commité). Toutes les variables sont optionnelles.

# development | test | production
NODE_ENV=development
# Interface et port d'écoute HTTP + WebSocket (+ page du jeu si client/dist existe)
HOST=0.0.0.0
PORT=3001
# debug | info | warn | error | silent
LOG_LEVEL=info
# pretty (lisible, dev) | json (production)
LOG_FORMAT=pretty
# Origines navigateur autorisées à ouvrir un WebSocket, séparées par des virgules.
# Vide = toutes (pratique en dev). En production, mettre l'URL publique du jeu.
ALLOWED_ORIGINS=
# Derrière un proxy / tunnel (Cloudflare Tunnel, nginx…) : true pour lire l'IP
# réelle du joueur (CF-Connecting-IP / X-Forwarded-For). Sinon tous les joueurs
# partagent l'IP du proxy et la limite MAX_CONNECTIONS_PER_IP devient globale.
TRUST_PROXY=false
# Dossier du client construit à servir (défaut : client/dist)
CLIENT_DIR=
# (dev) Restreint les micro-jeux joués à une liste d'ids, ex : saute,patate,boss-recre
BOUCAN_MICROGAMES=
# (dev) Multiplie toutes les durées de phase (0.3 = ~3× plus rapide). Doit valoir 1 en production.
BOUCAN_TIME_SCALE=1
# Nombre maximal de rooms simultanées
MAX_ROOMS=500
# Connexions WebSocket simultanées max par adresse IP
MAX_CONNECTIONS_PER_IP=32
