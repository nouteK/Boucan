# ─── BOUCAN V2 — variables d'environnement du serveur ─────────────────────────
# Copier ce fichier en `.env` (jamais commité). Toutes les variables sont optionnelles.

# development | test | production
NODE_ENV=development
# Interface et port d'écoute HTTP + WebSocket
HOST=0.0.0.0
PORT=3001
# debug | info | warn | error | silent
LOG_LEVEL=info
# pretty (lisible, dev) | json (production)
LOG_FORMAT=pretty
# Origines navigateur autorisées à ouvrir un WebSocket, séparées par des virgules.
# Vide = toutes (pratique en dev). En production, mettre l'URL du frontend.
ALLOWED_ORIGINS=
# (dev) Restreint les micro-jeux joués à une liste d'ids, ex : sonnerie,course-couloir
BOUCAN_MINIGAMES=
# (dev) Multiplie toutes les durées de phase (0.2 = 5× plus rapide). 1 par défaut.
BOUCAN_TIME_SCALE=1
# Nombre maximal de rooms simultanées
MAX_ROOMS=500
# Connexions WebSocket simultanées max par adresse IP
MAX_CONNECTIONS_PER_IP=32
