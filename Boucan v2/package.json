{
  "name": "boucan",
  "version": "2.0.0",
  "private": true,
  "description": "BOUCAN — jeu navigateur multijoueur façon WarioWare : micro-jeux de 4 secondes, en ligne, 1 à 8 joueurs",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "sdk",
    "client"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w @boucan/server",
    "dev:client": "npm run dev -w @boucan/client",
    "start": "npm run start -w @boucan/server",
    "build": "npm run typecheck && npm run build -w @boucan/client && npm run build -w @boucan/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:integration": "npm run check:integration -w @boucan/sdk --",
    "bots": "npm run bots -w @boucan/sdk --"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
