{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nickname": {
      "type": "string",
      "maxLength": 200
    },
    "characterId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$",
      "description": "Logical character id (frontend-owned roster)"
    },
    "config": {
      "type": "object",
      "properties": {
        "rounds": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "minigamePool": {
          "anyOf": [
            {
              "minItems": 1,
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
                "description": "Minigame slug"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "required": [
    "nickname"
  ],
  "title": "messages/client/room.create.payload",
  "$comment": "GENERATED by `npm run contract:generate` from shared/src/contracts — do not edit."
}
