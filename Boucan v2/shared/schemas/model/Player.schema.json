{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Opaque player id"
    },
    "nickname": {
      "type": "string"
    },
    "characterId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$",
          "description": "Logical character id (frontend-owned roster)"
        },
        {
          "type": "null"
        }
      ]
    },
    "seat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "isHost": {
      "type": "boolean"
    },
    "ready": {
      "type": "boolean"
    },
    "connection": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "left"
      ]
    },
    "score": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "joinedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Server epoch time (ms)"
    }
  },
  "required": [
    "id",
    "nickname",
    "characterId",
    "seat",
    "isHost",
    "ready",
    "connection",
    "score",
    "joinedAt"
  ],
  "additionalProperties": false,
  "title": "model/Player",
  "$comment": "GENERATED by `npm run contract:generate` from shared/src/contracts — do not edit."
}
