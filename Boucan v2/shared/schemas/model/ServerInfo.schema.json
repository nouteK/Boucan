{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "contractRevision": {
      "type": "string"
    },
    "serverVersion": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "development",
        "test",
        "production"
      ]
    },
    "serverTime": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Server epoch time (ms)"
    },
    "connectionId": {
      "type": "string"
    },
    "limits": {
      "type": "object",
      "properties": {
        "minPlayers": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "maxPlayers": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "roundOptions": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "defaultRounds": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "nicknameMinLength": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "nicknameMaxLength": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "maxMessageBytes": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "characterIds": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$",
                "description": "Logical character id (frontend-owned roster)"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "minPlayers",
        "maxPlayers",
        "roundOptions",
        "defaultRounds",
        "nicknameMinLength",
        "nicknameMaxLength",
        "maxMessageBytes",
        "characterIds"
      ],
      "additionalProperties": false
    },
    "timings": {
      "type": "object",
      "properties": {
        "matchStartingMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "preparingMinMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "preparingMaxMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "countdownMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endingMinMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reportGraceMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "resultsMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "intermissionMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "matchResultsMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "matchStartingMs",
        "preparingMinMs",
        "preparingMaxMs",
        "countdownMs",
        "endingMinMs",
        "reportGraceMs",
        "resultsMs",
        "intermissionMs",
        "matchResultsMs"
      ],
      "additionalProperties": false
    },
    "reconnect": {
      "type": "object",
      "properties": {
        "lobbyGraceMs": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "matchGraceMs": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "lobbyGraceMs",
        "matchGraceMs"
      ],
      "additionalProperties": false
    },
    "minigames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
            "description": "Minigame slug"
          },
          "authority": {
            "type": "string",
            "enum": [
              "local",
              "relay",
              "server"
            ]
          },
          "minPlayers": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "maxPlayers": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 8
          },
          "durationMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "scoring": {
            "type": "object",
            "properties": {
              "strategy": {
                "type": "string",
                "enum": [
                  "placement",
                  "threshold",
                  "normalized"
                ]
              },
              "rankBy": {
                "minItems": 1,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "metric": {
                      "type": "string",
                      "enum": [
                        "score",
                        "timeMs",
                        "accuracy",
                        "errors",
                        "normalized",
                        "rank"
                      ]
                    },
                    "order": {
                      "type": "string",
                      "enum": [
                        "asc",
                        "desc"
                      ]
                    }
                  },
                  "required": [
                    "metric",
                    "order"
                  ],
                  "additionalProperties": false
                }
              },
              "failures": {
                "type": "string",
                "enum": [
                  "zero",
                  "ranked"
                ]
              }
            },
            "required": [
              "strategy",
              "rankBy"
            ],
            "additionalProperties": false
          },
          "acceptsReports": {
            "type": "boolean"
          },
          "acceptsInputs": {
            "type": "boolean"
          },
          "inputRate": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "authority",
          "minPlayers",
          "maxPlayers",
          "durationMs",
          "scoring",
          "acceptsReports",
          "acceptsInputs",
          "inputRate"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "protocolVersion",
    "contractRevision",
    "serverVersion",
    "environment",
    "serverTime",
    "connectionId",
    "limits",
    "timings",
    "reconnect",
    "minigames"
  ],
  "additionalProperties": false,
  "title": "model/ServerInfo",
  "$comment": "GENERATED by `npm run contract:generate` from shared/src/contracts — do not edit."
}
