{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "playerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Opaque player id"
    },
    "result": {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "success",
            "failure",
            "dnf"
          ]
        },
        "score": {
          "type": "number",
          "minimum": -1000000000,
          "maximum": 1000000000
        },
        "timeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "errors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "normalized": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stats": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 32
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    },
    "rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "points": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "playerId",
    "result",
    "rank",
    "points"
  ],
  "additionalProperties": false,
  "title": "model/RoundEntry",
  "$comment": "GENERATED by `npm run contract:generate` from shared/src/contracts — do not edit."
}
