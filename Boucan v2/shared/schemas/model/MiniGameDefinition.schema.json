{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
      "description": "Minigame slug"
    },
    "authority": {
      "type": "string",
      "enum": [
        "local",
        "relay",
        "server"
      ]
    },
    "minPlayers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxPlayers": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 8
    },
    "durationMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "scoring": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "placement",
            "threshold",
            "normalized"
          ]
        },
        "rankBy": {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric": {
                "type": "string",
                "enum": [
                  "score",
                  "timeMs",
                  "accuracy",
                  "errors",
                  "normalized",
                  "rank"
                ]
              },
              "order": {
                "type": "string",
                "enum": [
                  "asc",
                  "desc"
                ]
              }
            },
            "required": [
              "metric",
              "order"
            ],
            "additionalProperties": false
          }
        },
        "failures": {
          "type": "string",
          "enum": [
            "zero",
            "ranked"
          ]
        }
      },
      "required": [
        "strategy",
        "rankBy"
      ],
      "additionalProperties": false
    },
    "acceptsReports": {
      "type": "boolean"
    },
    "acceptsInputs": {
      "type": "boolean"
    },
    "inputRate": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "id",
    "authority",
    "minPlayers",
    "maxPlayers",
    "durationMs",
    "scoring",
    "acceptsReports",
    "acceptsInputs",
    "inputRate"
  ],
  "additionalProperties": false,
  "title": "model/MiniGameDefinition",
  "$comment": "GENERATED by `npm run contract:generate` from shared/src/contracts — do not edit."
}
